package DinosTerminal;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}

{$DESIGNONLY}
{$IMPLICITBUILD OFF}

requires
  rtl,
  vcl,
  designide;

contains
  uMain in 'uMain.pas' {ManangerTerminal},
  uRegister in 'uRegister.pas',
  WinAPI.ConPty in 'WinAPI.ConPty.pas',
  Dinos.Terminal.Pty in 'Dinos.Terminal.Pty.pas',
  Dinos.Terminal.ConPtyReader in 'Dinos.Terminal.ConPtyReader.pas',
  Dinos.Terminal.ConPtyShell in 'Dinos.Terminal.ConPtyShell.pas',
  Dinos.Terminal.ScreenBuffer in 'Dinos.Terminal.ScreenBuffer.pas',
  Dinos.Terminal.VTParser in 'Dinos.Terminal.VTParser.pas',
  Dinos.Terminal.TerminalView in 'Dinos.Terminal.TerminalView.pas',
  Dinos.Terminal.KeyInput in 'Dinos.Terminal.KeyInput.pas',
  Dinos.Terminal.CmdShell in 'Dinos.Terminal.CmdShell.pas',
  Dinos.Terminal.Frame in 'Dinos.Terminal.Frame.pas' {TerminalFrame: TFrame},
  Dinos.Terminal.Interrupt in 'Dinos.Terminal.Interrupt.pas',
  Dinos.Terminal.Debug in 'Dinos.Terminal.Debug.pas';

end.
